# Flutter / Dart
# pubspec.lock est VERSIONNÉ : c'est une application, pas une bibliothèque. Sans lui, une
# reconstruction (ou la publication automatique) prendrait des versions de paquets différentes
# de celles qui ont été testées.
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies
*.iml
.idea/

# Données brutes (téléchargées, pas versionnées) — on versionne le JSON compact généré
data/gtfs/*.zip

# Captures
docs/captures/*.png
!docs/captures/.gitkeep

# Python (outils de conversion)
__pycache__/
*.pyc

# Documents de travail internes : présents sur le poste, volontairement hors du dépôt.
CLAUDE.md
docs/dossier-projet.md
docs/dossier-candidature.pdf
docs/dossier-candidature.py
docs/lettre-accompagnement.pdf
docs/lettre-accompagnement.py
